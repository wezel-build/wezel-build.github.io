---
// The Wezel wordmark. Shared by the landing header and the docs header so the
// two chromes can't drift apart.
interface Props {
  href?: string;
}

const { href = "/" } = Astro.props;
---

<a href={href} class="brand" aria-label="Wezel home">
  <svg
    class="brand-mark"
    width="28"
    height="28"
    viewBox="0 0 28 28"
    fill="none"
    aria-hidden="true"
  >
    <rect
      x="2.5"
      y="2.5"
      width="16"
      height="16"
      rx="4"
      stroke="var(--color-accent)"
      stroke-width="2.5"></rect>
    <rect x="12" y="12" width="13" height="13" rx="4" fill="var(--color-good)"></rect>
  </svg>
  <span class="brand-name">wezel</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }
  .brand-mark {
    flex: none;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.55rem;
    line-height: 1;
    color: var(--color-ink);
  }
</style>
