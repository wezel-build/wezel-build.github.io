---
// Compact contact links for the homepage signal block.
// Discord and Bluesky paths are the official simple-icons marks, copied here so
// the page carries no icon dependency.
---

<span class="contact-links">
  <a href="mailto:hi@wezel.build" aria-label="Email Wezel">
    <span class="contact-icon contact-at" aria-hidden="true">@</span>
    <span>email</span>
  </a>{" "}
  <a
    href="https://discord.gg/HySRs8TRvH"
    rel="noopener"
    aria-label="Wezel on Discord"
  >
    <span class="contact-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="13" height="13">
