      </svg>
    </span>
    <span>discord</span>
  </a>{" "}
  <a
    href="https://bsky.app/profile/wezel.build"
    rel="me noopener"
    aria-label="Wezel on Bluesky"
  >
    <span class="contact-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="13" height="13">
        <path d="M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026"></path>
      </svg>
    </span>
    <span>bluesky</span>
  </a>
</span>

<style>
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .contact-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    min-height: 2rem;
    padding: 0.38rem 0.65rem;
    border: 1px solid var(--color-line);
    background: var(--color-chrome);
    color: var(--color-ink-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1;
    text-decoration: none;
    transition:
      border-color 0.16s ease,
      color 0.16s ease,
      transform 0.16s ease;
  }

  .contact-links a:hover {
    border-color: var(--color-chrome-strong);
    color: var(--color-ink);
  }

  .contact-links a:focus-visible {
    outline: 1px solid var(--color-accent);
    outline-offset: -1px;
  }

  .contact-links a:active {
    transform: translateY(1px);
  }

  .contact-icon {
    width: 0.82rem;
    height: 0.82rem;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    color: currentColor;
  }

  .contact-at {
    font: 600 0.78rem/1 var(--font-mono);
  }

  .contact-icon svg {
    display: block;
    fill: currentColor;
  }
</style>
