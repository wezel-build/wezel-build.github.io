---
// Match the homepage footer without repeating its contacts or primary action.
---

<footer class="site-footer">
  <div class="footer-inner">
    <span>&copy; {new Date().getFullYear()} Wezel</span>

    <nav aria-label="Footer">
      <a href="/docs">Docs</a>{" "}
      <a href="/blog">Blog</a>{" "}
      <a href="https://status.wezel.build" rel="noopener">Status</a>{" "}
      <a href="https://app.wezel.build">Open app</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    width: min(100%, var(--site-width));
    margin-inline: auto;
    padding: 0 var(--site-gutter) 1.5rem;
  }

  .footer-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--color-line);
    padding-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--color-ink-faint);
  }

  .footer-inner nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-inner a {
    text-decoration: none;
    color: inherit;
    transition: color 0.15s ease;
  }

  .footer-inner a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-footer :global(*) {
    border-radius: 0;
    box-shadow: none;
  }

  .footer-inner a:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
  }
</style>
