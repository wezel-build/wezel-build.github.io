---
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  rail?: boolean;
}

const { rail = false } = Astro.props;
---

<footer class:list={["site-footer", { "site-footer--rail": rail }]}>
  <div class="footer-inner">
    <span>&copy; {new Date().getFullYear()} Wezel</span>
    <nav aria-label="Footer">
      {!rail && <a href="/docs">Docs</a>}{" "}
      <a href="/blog">Blog</a>{" "}
      <a href="https://status.wezel.build" rel="noopener">Status</a>{" "}
      <a href="https://app.wezel.build">Open app</a>
    </nav>
    <ThemeToggle />
  </div>
</footer>

<style>
  .site-footer {
    width: min(100%, var(--site-width));
    margin-inline: auto;
    padding: 0 var(--site-gutter) 1.5rem;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--color-line);
    padding-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--color-ink-faint);
  }

  .footer-inner nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-inline-start: auto;
  }

  .footer-inner a {
    text-decoration: none;
    color: inherit;
    transition: color 0.15s ease;
  }

  .footer-inner a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-footer :global(*) {
    border-radius: 0;
    box-shadow: none;
  }

  .footer-inner a:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
  }

  .site-footer--rail {
    width: 100%;
    margin-top: auto;
    padding: 1.5rem 0 0;
  }

  .site-footer--rail .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: stretch;
    gap: 0.75rem;
    padding-top: 1rem;
    font-size: 0.75rem;
  }

  .site-footer--rail .footer-inner nav {
    grid-column: 1 / -1;
    grid-row: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem 0.75rem;
    margin-inline-start: 0;
  }

  .site-footer--rail .footer-inner > span {
    align-self: center;
  }

  .site-footer--rail .footer-inner :global(.theme-toggle) {
    justify-self: end;
  }
</style>
