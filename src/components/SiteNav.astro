---
interface Props {
  action?: { href: string; label: string };
}

const { action = { href: "/docs/installation", label: "Install CLI" } } = Astro.props;

// Site destinations and the primary action share one navigation row.
//
// The {" "} between links is load-bearing. Astro trims the newline before a tag
// to nothing, so `gap` would otherwise be the only thing separating these words
// and the failure mode is "DocsBlogStatus". Flex ignores whitespace-only text
// nodes, so it costs nothing when gap applies.

const links = [
  { href: "/docs", label: "Docs" },
  { href: "/blog", label: "Blog" },
  { href: "https://status.wezel.build", label: "Status", external: true },
];

const path = Astro.url.pathname;
---

<nav class="header-nav" aria-label="Site">
  <span class="nav-links">
    {
      links.map(({ href, label, external }, i) => (
        <>
          {i > 0 ? " " : ""}
          <a
            href={href}
            aria-current={!external && path.startsWith(href) ? "page" : undefined}
            {...external ? { rel: "noopener" } : {}}
          >
            {label}
          </a>
        </>
      ))
    }
  </span>

  <a href={action.href} class="header-cta">{action.label}</a>
</nav>

<style>
  .header-nav {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    font-size: 0.95rem;
  }

  .nav-links {
    display: inline-flex;
    align-items: center;
  }

  .nav-links {
    gap: 1.6rem;
  }

  .header-nav a {
    color: var(--color-ink-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .header-nav a:hover {
    color: var(--color-ink);
  }

  /* Accent is a signal: it marks where you are, nothing else. */
  .header-nav a[aria-current="page"]:not(.header-cta) {
    color: var(--color-accent);
  }

  .header-cta {
    border: 1px solid var(--color-line-strong);
    background: var(--color-chrome);
    padding: 0.35rem 0.85rem;
    color: var(--color-ink) !important;
  }

  .header-cta:hover {
    border-color: var(--color-chrome-strong);
  }

  @media (max-width: 64rem) {
    .nav-links {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .header-nav {
      display: none;
    }
  }
</style>
