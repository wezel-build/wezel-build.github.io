---
import Brand from "../Brand.astro";
import DocsSearch from "./DocsSearch.astro";
import ThemeToggle from "../ThemeToggle.astro";

// Mirrors the landing header. The frame (height, hairline, translucent
// background) belongs to the header itself now that Starlight's PageFrame is
// gone — see DOCS-DESIGN.md §4.
const links = [
  { href: "/docs", label: "Docs" },
  { href: "/blog", label: "Blog" },
  { href: "https://status.wezel.build", label: "Status", external: true },
  { href: "https://github.com/wezel-build", label: "GitHub", external: true },
];

const path = Astro.url.pathname;
---

<header class="docs-header">
  <Brand href="/" />

  <div class="header-right">
    <DocsSearch />

    <nav class="header-nav" aria-label="Site">
      {
        links.map(({ href, label, external }) => (
          <a
            href={href}
            aria-current={!external && path.startsWith(href) ? "page" : undefined}
            {...external ? { rel: "noopener" } : {}}
          >
            {label}
          </a>
        ))
      }
      <ThemeToggle />
      <a href="/docs/installation" class="header-cta">Install CLI</a>
    </nav>

    <button
      class="sidebar-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="docs-sidebar"
    >
      Contents
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".sidebar-toggle");
  const sidebar = document.getElementById("docs-sidebar");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    sidebar?.toggleAttribute("data-open", !open);
  });
</script>
