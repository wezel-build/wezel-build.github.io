---
import type { Breadcrumb } from "../../lib/docs-navigation.ts";

interface Props {
  title: string;
  description?: string | undefined;
  breadcrumbs: Breadcrumb[];
}

const { title, description, breadcrumbs } = Astro.props;
---

<div class="docs-page-header">
  {
    breadcrumbs.length > 0 && (
      <nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore>
        {breadcrumbs.map((crumb) =>
          crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>,
        )}
      </nav>
    )
  }
  <h1>{title}</h1>
  {description && <p class="standfirst">{description}</p>}
</div>
