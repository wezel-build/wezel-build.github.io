---
// Docs search: a ⌘K dialog over Pagefind (DOCS-DESIGN.md build plan, step 10).
//
// Pagefind's own UI is not used. It ships a widget whose markup and class names
// are its interface, which is the same coupling that made Starlight untenable
// here (§2). Instead this talks to the Pagefind JS API and renders results in
// the docs' own language: hairline borders, radius 0, no shadows, mono for
// apparatus, accent reserved as a signal.
//
// A native <dialog> is deliberate: showModal() promotes it to the top layer, so
// it escapes the sticky header's stacking context and gets Esc-to-close and
// focus trapping without any of that being hand-rolled.
//
// The index lives at /pagefind/pagefind.js, generated after `astro build`. In
// `astro dev` it is served from the previous build output, so search is inert
// until a build has run once.
---

<button
  class="search-trigger"
  type="button"
  aria-keyshortcuts="Meta+K Control+K"
  data-search-open
>
  <span>Search</span>
  <kbd>⌘K</kbd>
</button>

<dialog class="search-dialog" aria-label="Search the docs">
  <form class="search-field" role="search" onsubmit="return false">
    <label class="search-label" for="docs-search-input">Search</label>
    <input
      id="docs-search-input"
      type="text"
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="go"
      placeholder="Search the docs"
      data-search-input
    />
    <kbd>Esc</kbd>
  </form>

  <div class="search-results" data-search-results>
    <p class="search-note" data-search-note>Type to search.</p>
    <ul data-search-list></ul>
  </div>

  <p class="search-status" role="status" aria-live="polite" data-search-status></p>
</dialog>

<style>
  /* ---- trigger: unchanged from the placeholder it replaces --------------- */
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    border: 1px solid var(--color-line-strong);
    background: var(--color-surface);
    padding: 0.3rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-ink-faint);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .search-trigger:hover {
    border-color: var(--color-ink-faint);
    color: var(--color-ink-soft);
  }

  kbd {
    font: inherit;
    background: var(--color-veil);
    padding: 0 0.3rem;
  }

  /* ---- dialog ----------------------------------------------------------- */
  /* display lives on [open] only. Setting it on .search-dialog beats the UA
     sheet's `dialog:not([open]) { display: none }` and leaves the panel on the
     page before it is ever opened. */
  .search-dialog {
    width: min(42rem, calc(100vw - 2rem));
    max-height: min(34rem, calc(100vh - 8rem));
    margin: 5.5rem auto auto;
    padding: 0;
    border: 1px solid var(--color-ink-faint);
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .search-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .search-dialog::backdrop {
    /* The desk, dimmed. Warm rather than neutral so the paper stays warm. */
    background: color-mix(in srgb, var(--color-ink) 22%, transparent);
  }

  /* ---- field: one rule under it, no box -------------------------------- */
  .search-field {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1.2rem;
    border-block-end: 1px solid var(--color-line);
  }

  .search-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    flex: none;
  }

  .search-field input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    color: var(--color-ink);
  }

  .search-field input::placeholder {
    color: var(--color-ink-faint);
  }

  .search-field input:focus {
    outline: none;
  }

  /* ---- results ---------------------------------------------------------- */
  .search-results {
    overflow-y: auto;
    padding: 0.35rem 0;
  }

  .search-results :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .search-results :global(li) {
    margin: 0;
  }

  .search-note,
  .search-status {
    margin: 0;
    padding: 0.9rem 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-ink-faint);
  }

  .search-status {
    border-block-start: 1px solid var(--color-line);
  }

  .search-status:empty {
    display: none;
  }

  .search-results :global(a) {
    display: block;
    padding: 0.7rem 1.2rem;
    text-decoration: none;
    color: inherit;
    border-inline-start: 2px solid transparent;
  }

  /* One highlight mechanism for hover, focus and arrow-key selection, so the
     keyboard and the mouse can't disagree about what is current. */
  .search-results :global(a:hover),
  .search-results :global(a:focus-visible),
  .search-results :global(a[data-current]) {
    background: var(--color-veil);
    border-inline-start-color: var(--color-accent);
    outline: none;
  }

  :global(.result-title) {
    display: block;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.012em;
  }

  :global(.result-crumb) {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: var(--color-ink-faint);
    margin-block-end: 0.15rem;
  }

  :global(.result-excerpt) {
    display: block;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
    margin-block-start: 0.2rem;
  }

  /* Same pairing as ::selection in global.css. */
  :global(.result-excerpt mark) {
    background: var(--color-accent-wash);
    color: var(--color-accent-deep);
  }

  /* A sub-result is a heading within a page: indented under its parent. */
  .search-results :global(a[data-sub]) {
    padding-block: 0.5rem;
    padding-inline-start: 2.2rem;
  }

  .search-results :global(a[data-sub] .result-title) {
    font-weight: 500;
    font-size: 0.94rem;
    color: var(--color-ink-soft);
  }

  /* Owned here rather than in docs.css: a scoped `.search-trigger` selector
     outspecifies a bare one in the global sheet, so a hide rule over there
     would silently lose to the display:flex above. */
  @media (max-width: 40rem) {
    .search-trigger {
      display: none;
    }

    .search-dialog {
      margin-top: 1rem;
      max-height: calc(100vh - 2rem);
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".search-dialog");
  const input = document.querySelector<HTMLInputElement>("[data-search-input]");
  const list = document.querySelector<HTMLUListElement>("[data-search-list]");
  const note = document.querySelector<HTMLParagraphElement>("[data-search-note]");
  const status = document.querySelector<HTMLParagraphElement>("[data-search-status]");
  const trigger = document.querySelector<HTMLButtonElement>("[data-search-open]");

  if (dialog && input && list && note && status && trigger) {
    type Sub = { title: string; url: string; excerpt: string };
    type Hit = {
      meta: { title?: string };
      url: string;
      excerpt: string;
      sub_results?: Sub[];
    };

    // The bundler must not try to resolve this: the module is generated by
    // Pagefind at build time and only exists in the output directory.
    const INDEX = "/pagefind/pagefind.js";

    let pagefind: any = null;
    let loadFailed = false;

    async function load() {
      if (pagefind || loadFailed) return;
      try {
        pagefind = await import(/* @vite-ignore */ INDEX);
        await pagefind.options({ excerptLength: 24 });
        await pagefind.init();
      } catch {
        loadFailed = true;
        note.textContent = "Search index unavailable. Run a build first.";
      }
    }

    function open() {
      if (dialog.open) return;
      dialog.showModal();
      input.focus();
      input.select();
      void load();
    }

    trigger.addEventListener("click", open);

    addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        open();
      }
    });

    // Clicking the backdrop closes. The dialog itself is the click target when
    // the backdrop is hit, so compare against the panel's own box.
    dialog.addEventListener("click", (e) => {
      const box = dialog.getBoundingClientRect();
      const outside =
        e.clientX < box.left ||
        e.clientX > box.right ||
        e.clientY < box.top ||
        e.clientY > box.bottom;
      if (outside) dialog.close();
    });

    dialog.addEventListener("close", () => {
      input.value = "";
      list.replaceChildren();
      note.hidden = false;
      note.textContent = "Type to search.";
      status.textContent = "";
    });

    function links() {
      return Array.from(list.querySelectorAll<HTMLAnchorElement>("a"));
    }

    function move(step: number) {
      const items = links();
      if (items.length === 0) return;
      const at = items.findIndex((a) => a.hasAttribute("data-current"));
      const next = at === -1 ? (step > 0 ? 0 : items.length - 1) : at + step;
      const wrapped = (next + items.length) % items.length;
      items.forEach((a) => a.removeAttribute("data-current"));
      const chosen = items[wrapped];
      chosen.setAttribute("data-current", "");
      chosen.scrollIntoView({ block: "nearest" });
    }

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        move(1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        move(-1);
      } else if (e.key === "Enter") {
        const chosen =
          list.querySelector<HTMLAnchorElement>("a[data-current]") ??
          list.querySelector<HTMLAnchorElement>("a");
        if (chosen) {
          e.preventDefault();
          location.href = chosen.href;
        }
      }
    });

    function line(
      href: string,
      title: string,
      crumb: string | null,
      excerpt: string | null,
      sub: boolean,
    ) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = href;
      if (sub) a.dataset.sub = "";

      if (crumb) {
        const c = document.createElement("span");
        c.className = "result-crumb";
        c.textContent = crumb;
        a.append(c);
      }

      const t = document.createElement("span");
      t.className = "result-title";
      t.textContent = title;
      a.append(t);

      if (excerpt) {
        const x = document.createElement("span");
        x.className = "result-excerpt";
        // Pagefind's excerpt is HTML with <mark> around the matches. The source
        // is our own build output, not user input.
        x.innerHTML = excerpt;
        a.append(x);
      }

      li.append(a);
      return li;
    }

    // "/docs/concepts/experiments/" -> "concepts"
    function crumbOf(url: string) {
      const parts = url.replace(/^\/|\/$/g, "").split("/");
      return parts.length > 2 ? parts.slice(1, -1).join(" / ") : null;
    }

    input.addEventListener("input", async () => {
      const q = input.value.trim();

      if (q === "") {
        list.replaceChildren();
        note.hidden = false;
        note.textContent = "Type to search.";
        status.textContent = "";
        return;
      }

      await load();
      if (loadFailed) return;

      const search = await pagefind.debouncedSearch(q, {}, 180);
      if (search === null) return; // a newer query superseded this one

      const hits: Hit[] = await Promise.all(
        search.results.slice(0, 6).map((r: any) => r.data()),
      );

      list.replaceChildren();

      if (hits.length === 0) {
        note.hidden = false;
        note.textContent = `No matches for “${q}”.`;
        status.textContent = "No results.";
        return;
      }

      note.hidden = true;

      for (const hit of hits) {
        const title = hit.meta.title ?? hit.url;
        const subs = (hit.sub_results ?? []).filter((s) => s.url !== hit.url);

        list.append(
          line(
            hit.url,
            title,
            crumbOf(hit.url),
            subs.length > 0 ? null : hit.excerpt,
            false,
          ),
        );

        for (const s of subs.slice(0, 3)) {
          list.append(line(s.url, s.title, null, s.excerpt, true));
        }
      }

      const pages = hits.length;
      status.textContent = `${pages} page${pages === 1 ? "" : "s"} · ↑↓ to move, ↵ to open`;
    });
  }
</script>
