---
import Search from "virtual:starlight/components/Search";
import Brand from "../Brand.astro";

// Mirrors the landing header in src/pages/index.astro. The frame itself (fixed
// position, height, hairline, translucent background) comes from Starlight's
// PageFrame; this only fills it.
const links = [
  { href: "/docs", label: "Docs" },
  { href: "/blog", label: "Blog" },
  { href: "/status", label: "Status" },
  { href: "https://github.com/wezel-build", label: "GitHub", external: true },
];

const path = Astro.url.pathname;
---

<div class="header-inner">
  <Brand href="/" />

  <div class="header-right">
    <div class="search-slot print:hidden"><Search /></div>

    <nav class="nav" aria-label="Site">
      {
        links.map(({ href, label, external }) => (
          <a
            href={href}
            aria-current={!external && path.startsWith(href) ? "page" : undefined}
            {...external ? { rel: "noopener" } : {}}
          >
            {label}
          </a>
        ))
      }
      <a href="/docs/installation" class="nav-cta">Install CLI</a>
    </nav>
  </div>
</div>

<style>
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 100%;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    min-width: 0;
  }

  .search-slot {
    width: clamp(8rem, 22vw, 14rem);
  }

  /* Starlight collapses the search button to an icon here; let it hug. */
  @media (max-width: 50rem) {
    .search-slot {
      width: auto;
    }
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    font-size: 0.95rem;
  }

  .nav a {
    color: var(--color-ink-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .nav a:hover {
    color: var(--color-ink);
  }

  /* single accent marks where you are */
  .nav a[aria-current="page"]:not(.nav-cta) {
    color: var(--color-accent);
  }

  .nav-cta {
    border: 1px solid var(--color-line-strong);
    border-radius: 0.5rem;
    padding: 0.4rem 0.85rem;
    color: var(--color-ink) !important;
  }

  .nav-cta:hover {
    border-color: var(--color-ink-faint);
  }

  /* Below the sidebar breakpoint the menu button takes over; keep only the
     brand, search and the CTA so the bar doesn't crowd. */
  @media (max-width: 62rem) {
    .nav a:not(.nav-cta) {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .nav-cta {
      display: none;
    }
  }
</style>
