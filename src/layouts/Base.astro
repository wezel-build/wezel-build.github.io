---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** "article" for blog posts; unfurlers treat the two differently. */
  ogType?: "website" | "article";
  /** ISO date, for og:type="article". */
  published?: string;
  bodyClass?: string;
}

const {
  title = "Wezel",
  description = "",
  ogType = "website",
  published,
  bodyClass,
} = Astro.props;

// Bluesky, Slack, Discord, iMessage and Mastodon all read Open Graph; none of
// them need `twitter:` tags, so there are none. Bluesky in particular ignores
// twitter:card entirely and falls back to og:image, hence one card definition
// rather than two.
//
// Astro.site comes from `site` in astro.config.mjs, so these are absolute - a
// relative og:image is silently dropped by most unfurlers.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Wezel"
      href="/rss.xml"
    />

    <meta property="og:type" content={ogType} />
    {published && <meta property="article:published_time" content={published} />}
    <meta property="og:site_name" content="Wezel" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Wezel - your build, always at its best"
    />

    {/*
      Applies a stored colour-scheme choice before first paint. `is:inline` and
      not deferred on purpose: bundled or async, the page would render in the OS
      scheme and then snap to the chosen one on every navigation. Absence of the
      attribute means auto, which global.css resolves from prefers-color-scheme.
    */}
    <script is:inline>
      try {
        const t = localStorage.getItem("wezel-theme");
        if (t === "light" || t === "dark")
          document.documentElement.dataset.theme = t;
      } catch {}
    </script>

    <link rel="preload" href="/fonts/source-sans-3-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-semi-condensed-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class={bodyClass}>
    <slot />

    <script>
      const activateCodeAnnotation = (
        group: HTMLElement,
        annotation: string,
      ) => {
        if (group.dataset.activeAnnotation === annotation) return;
        group.dataset.activeAnnotation = annotation;

        group.querySelectorAll<HTMLElement>("[data-code-annotation]").forEach((line) => {
          line.classList.toggle(
            "is-active",
            line.dataset.codeAnnotation === annotation,
          );
        });

        group.querySelectorAll<HTMLButtonElement>("[data-annotation-target]").forEach((tab) => {
          const active = tab.dataset.annotationTarget === annotation;
          tab.setAttribute("aria-selected", String(active));
          tab.tabIndex = active ? 0 : -1;
        });

        group.querySelectorAll<HTMLElement>("[role='tabpanel']").forEach((panel) => {
          panel.hidden = !panel.id.endsWith(`-${annotation}`);
        });

        const selected = group.querySelector<HTMLButtonElement>(
          `[data-annotation-target="${annotation}"]`,
        );
        const source = group.querySelector<HTMLElement>(".annotated-code__source");
        if (selected && source) {
          source.setAttribute("aria-describedby", selected.getAttribute("aria-controls") ?? "");
        }
      };

      document.querySelectorAll<HTMLElement>(".annotated-code").forEach((group) => {
        group.addEventListener("pointerover", (event) => {
          const target = (event.target as Element).closest<HTMLElement>(
            "[data-code-annotation], [data-annotation-target]",
          );
          const annotation =
            target?.dataset.codeAnnotation ?? target?.dataset.annotationTarget;
          if (annotation) activateCodeAnnotation(group, annotation);
        });

        group.addEventListener("click", (event) => {
          const target = (event.target as Element).closest<HTMLElement>(
            "[data-code-annotation], [data-annotation-target]",
          );
          const annotation =
            target?.dataset.codeAnnotation ?? target?.dataset.annotationTarget;
          if (annotation) activateCodeAnnotation(group, annotation);
          if (target?.dataset.codeAnnotation) {
            group
              .querySelector<HTMLElement>(".annotated-code__source")
              ?.focus({ preventScroll: true });
          }
        });

        group.addEventListener("keydown", (event) => {
          const tab = (event.target as Element).closest<HTMLButtonElement>(
            "[data-annotation-target]",
          );
          const source = (event.target as Element).closest(".annotated-code__source");
          if (event.key === "Escape" && (tab !== null || source !== null)) {
            (event.target as HTMLElement).blur();
            return;
          }
          if (
            (tab === null && source === null) ||
            !["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)
          ) {
            return;
          }

          event.preventDefault();
          const tabs = Array.from(
            group.querySelectorAll<HTMLButtonElement>("[data-annotation-target]"),
          );
          const current = Number(group.dataset.activeAnnotation) - 1;
          const nextIndex =
            event.key === "Home"
              ? 0
              : event.key === "End"
                ? tabs.length - 1
                : (current + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) %
                  tabs.length;
          const next = tabs[nextIndex];
          activateCodeAnnotation(group, next.dataset.annotationTarget ?? "1");
          if (tab !== null) next.focus();
        });
      });
    </script>
  </body>
</html>
