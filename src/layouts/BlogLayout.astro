---
import Base from "./Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article";
  published?: string;
}
---

<Base {...Astro.props} bodyClass="blog-page">
  <a class="blog-skip-link" href="#main-content">Skip to content</a>
  <SiteHeader />
  <main class="blog-shell" id="main-content" tabindex="-1">
    <slot />
  </main>
  <SiteFooter />
</Base>

<style>
  :global(body.blog-page) {
    --blog-width: 50rem;
    --blog-gutter: 3rem;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  .blog-shell {
    flex: 1;
    width: min(100%, var(--blog-width));
    min-width: 0;
    margin-inline: auto;
    padding: 2.5rem var(--blog-gutter) 3rem;
  }

  .blog-shell:focus {
    outline: none;
  }

  .blog-shell :global(*) {
    letter-spacing: 0;
  }

  .blog-shell :global(a:focus-visible) {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
  }

  .blog-skip-link {
    position: fixed;
    inset: 0.5rem auto auto 0.5rem;
    z-index: 30;
    transform: translateY(-200%);
    padding: 0.5rem 1rem;
    background: var(--color-surface);
    color: var(--color-ink);
    border: 1px solid var(--color-line-strong);
  }

  .blog-skip-link:focus {
    transform: none;
  }

  @media (max-width: 48rem) {
    :global(body.blog-page) {
      --blog-gutter: 1.25rem;
    }

    .blog-shell {
      padding-block: 1.75rem 2.5rem;
    }
  }
</style>
