---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";

import "../../styles/docs.css";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { fetchAuthors, type Author } from "../../lib/authors";

// Share the docs' prose styles while keeping the blog's reading width and chrome.

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return Promise.all(
    posts.map(async (post) => ({
      params: { id: post.id },
      props: { post, authors: await fetchAuthors(post.data.author) },
    })),
  );
};

interface Props {
  post: Awaited<ReturnType<typeof getCollection<"blog">>>[number];
  authors: Author[];
}

const { post, authors } = Astro.props as Props;
const { Content } = await render(post);

const dateFormat = new Intl.DateTimeFormat("en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BlogLayout
  title={`${post.data.title} - Wezel`}
  description={post.data.description}
  ogType="article"
  published={post.data.date.toISOString()}
>
  <div class="post-sheet">
    <article>
      <header class="post-head">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/blog">Blog</a>
        </nav>

        <h1>{post.data.title}</h1>
        <p class="standfirst">{post.data.description}</p>

        <div class="byline">
          <time datetime={post.data.date.toISOString()} class="label">
            {dateFormat.format(post.data.date)}
          </time>

          <ul class="authors">
            {
              authors.map((author) => (
                <li>
                  <a href={author.htmlUrl} rel="noopener">
                    {author.avatar && (
                      <img
                        src={author.avatar}
                        alt=""
                        width="22"
                        height="22"
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    <span>{author.name}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </header>

      <div class="docs-prose post-body">
        <Content />
      </div>
    </article>

    <p class="back">
      <a href="/blog">&larr; All posts</a>
    </p>
  </div>

  <style>
    .post-sheet :global(*) {
      border-radius: 0;
      box-shadow: none;
    }

    .label,
    .crumb {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0;
      color: var(--color-ink-faint);
    }

    .post-head {
      margin-bottom: 1.75rem;
    }

    .crumb {
      margin-bottom: 0.75rem;
    }

    .crumb a {
      color: inherit;
      text-decoration: none;
    }

    .crumb a:hover {
      color: var(--color-ink);
    }

    .post-head h1 {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 700;
      font-size: 2.5rem;
      line-height: 1.15;
      text-wrap: balance;
      overflow-wrap: anywhere;
    }

    .post-head .standfirst {
      max-width: 60ch;
      margin: 0.875rem 0 0;
      font-size: 1.125rem;
      line-height: 1.5;
      color: var(--color-ink-soft);
    }

    .byline {
      display: flex;
      align-items: center;
      gap: 0.75rem 1.25rem;
      flex-wrap: wrap;
      margin-top: 1rem;
    }

    .authors {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.1rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .authors a {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      font-size: 0.92rem;
      color: var(--color-ink-soft);
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .authors a:hover {
      color: var(--color-ink);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    .authors img {
      display: block;
      /* A face is the one place on this site where a circle earns itself. */
      border-radius: 50% !important;
    }

    .post-body {
      max-width: none;
      padding: 0;
      font-size: 1.125rem;
      line-height: 1.7;
    }

    .post-body :global(:is(p, li)) {
      overflow-wrap: anywhere;
    }

    .post-body :global(p > img) {
      display: block;
      margin: 1.5rem auto;
    }

    .post-body :global([id]) {
      scroll-margin-top: 6rem;
    }

    .post-body :global(.footnotes) {
      margin-top: 2rem;
      padding-top: 1rem;
      border-top: 1px solid var(--color-line);
      color: var(--color-ink-soft);
      font-size: 0.9375rem;
    }

    .post-body :global(.footnotes p) {
      margin: 0;
    }

    .back {
      margin: 2rem 0 0;
    }

    .back a {
      font-size: 0.9375rem;
      color: var(--color-ink-soft);
      text-decoration: underline;
      text-decoration-color: var(--color-line-strong);
      text-underline-offset: 0.2em;
    }

    .back a:hover {
      color: var(--color-ink);
      text-decoration-color: currentColor;
    }

    @media (max-width: 48rem) {
      .post-head h1 {
        font-size: 2rem;
      }

      .post-body {
        font-size: 1.05rem;
      }
    }
  </style>
</BlogLayout>
