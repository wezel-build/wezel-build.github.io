---
import { getCollection } from "astro:content";

import BlogLayout from "../../layouts/BlogLayout.astro";
import { fetchAuthors, type Author } from "../../lib/authors";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const authorsByPost = new Map<string, Author[]>(
  await Promise.all(
    posts.map(
      async (post) => [post.id, await fetchAuthors(post.data.author)] as const,
    ),
  ),
);

const dateFormat = new Intl.DateTimeFormat("en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BlogLayout
  title="Blog - Wezel"
  description="Notes on build performance, developer tooling, and building Wezel."
>
  <div class="sheet">
    <section class="band masthead-band">
      <div class="masthead">
        <span class="label">Blog</span>
        <!-- One expression, not two: Astro trims the newline between them to
             nothing, which renders "1POST". -->
        <span class="label">
          {`${posts.length} ${posts.length === 1 ? "post" : "posts"}`}
        </span>
      </div>

      <div class="intro">
        <h1>Notes on build performance</h1>
        <p class="standfirst">
          Why builds get slower, what it costs, and what Wezel does about it.
        </p>
      </div>
    </section>

    <section class="band">
      {
        posts.length === 0 && (
          <p class="empty">Nothing published yet.</p>
        )
      }

      <ol class="posts">
        {
          posts.map((post) => {
            const authors = authorsByPost.get(post.id) ?? [];
            return (
              <li>
                <a href={`/blog/${post.id}`}>
                  <time datetime={post.data.date.toISOString()} class="label">
                    {dateFormat.format(post.data.date)}
                  </time>
                  <h2>{post.data.title}</h2>
                  <p class="dek">{post.data.description}</p>
                  {authors.length > 0 && (
                    <p class="byline label">
                      {authors.map((a) => a.name).join(", ")}
                    </p>
                  )}
                </a>
              </li>
            );
          })
        }
      </ol>
    </section>
  </div>

  <style>
    .sheet {
      font-size: 1.08rem;
    }

    .sheet :global(*) {
      border-radius: 0;
      box-shadow: none;
    }

    .label {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0;
      color: var(--color-ink-faint);
    }

    .masthead {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
    }

    .intro {
      padding-block: 0.75rem 2rem;
    }

    h1 {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 700;
      font-size: 2.5rem;
      line-height: 1.15;
      text-wrap: balance;
      overflow-wrap: anywhere;
    }

    .standfirst {
      margin: 0.875rem 0 0;
      max-width: 60ch;
      font-size: 1.125rem;
      line-height: 1.5;
      color: var(--color-ink-soft);
    }

    .posts {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--color-line);
    }

    .posts li {
      border-bottom: 1px solid var(--color-line);
    }

    .posts a {
      display: grid;
      grid-template-columns: 8.5rem minmax(0, 1fr);
      column-gap: 1.5rem;
      padding: 1.5rem 0;
      text-decoration: none;
      color: inherit;
    }

    .posts time {
      grid-column: 1;
      grid-row: 1 / span 3;
      padding-top: 0.3rem;
    }

    .posts :is(h2, .dek, .byline) {
      grid-column: 2;
      overflow-wrap: anywhere;
    }

    .posts h2 {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 650;
      font-size: 1.5rem;
      line-height: 1.25;
      max-width: 40ch;
    }

    .posts a:hover h2,
    .posts a:focus-visible h2 {
      text-decoration: underline;
      text-decoration-color: var(--color-ink-faint);
      text-underline-offset: 0.2em;
    }

    .dek {
      margin: 0.4rem 0 0;
      max-width: 60ch;
      font-size: 1rem;
      line-height: 1.55;
      color: var(--color-ink-soft);
    }

    .byline {
      margin: 0.6rem 0 0;
    }

    .empty {
      margin: 0 0 2rem;
      color: var(--color-ink-faint);
    }

    @media (max-width: 48rem) {
      h1 {
        font-size: 2rem;
      }

      .posts h2 {
        font-size: 1.35rem;
      }

      .posts a {
        grid-template-columns: minmax(0, 1fr);
      }

      .posts time {
        grid-row: auto;
        padding-top: 0;
        margin-bottom: 0.5rem;
      }

      .posts :is(h2, .dek, .byline) {
        grid-column: 1;
      }
    }
  </style>
</BlogLayout>
