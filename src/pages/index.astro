  /* Time cursor — sweeps linearly so the playhead lines up with the commit
     it's passing over. Don't switch to cubic-bezier here; the commit delays
     are linear and any easing desyncs them. The cursor PAUSES briefly at each
     sample commit during the sweep (150ms each), then jumps back to track
     each bisection step's commit before fading out as the marker locks in. */
  .chart-svg .time-cursor {
    transform: translate(4px, 0);
    will-change: transform, opacity;
    animation: cursor-sweep 8000ms linear 0ms forwards;
  }
