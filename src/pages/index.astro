---
import Base from "../layouts/Base.astro";
import "../styles/home.css";
import { Content as Body } from "../home/index.mdx";

const installUrl = new URL(
    "install.sh",
    Astro.site ?? "https://wezel.build/",
).toString();
const installCmd = `curl -fsSL ${installUrl} | sh`;
---

<Base>
    <!-- ── Hero (centered wordmark, vixen-style) ─────────── -->
    <section class="hero">
        <div class="hero-inner">
            <div class="hero-mark" aria-hidden="true">w</div>

            {/* copy slot: wordmark (usually the product name) */}
            <h1 class="hero-word">wezel</h1>

            {/* copy slot: tagline */}
            <p class="hero-tagline">Build-time observability</p>

            {/* copy slot: subtitle */}
            <p class="hero-sub">
                Wezel benchmarks the build scenarios your team runs most, on
                every commit, and surfaces the offending change the moment
                something gets slower.
            </p>

            {/* copy slot: status banner — edit or delete */}
            <p class="hero-banner">
                Early development · not yet ready for production
            </p>

            <div class="hero-ctas">
                <a
                    href="https://github.com/wezel-build/wezel"
                    class="btn btn-lg btn-primary"
                    target="_blank"
                    rel="noopener"
                >
                    Get started
                </a>
                <a href="/docs" class="btn btn-lg btn-secondary">
                    Read the docs
                </a>
            </div>
        </div>
    </section>

    <!-- ── Body (authored in src/home/index.mdx) ─────────── -->
    <section class="body">
        <article class="prose">
            <Body />
        </article>
    </section>

    <!-- ── Closing ───────────────────────────────────────── -->
    <section class="closing">
        <div class="closing-inner">
            {/* copy slot: closing line */}
            <p class="closing-lead">Install the CLI and point it at a build.</p>

            <figure class="install-snippet">
                <figcaption>
                    <span class="install-shell">shell</span>
                    <button
                        class="install-copy"
                        type="button"
                        data-copy={installCmd}
                        aria-label="Copy install command"
                    >
                        <span class="install-copy-text">copy</span>
                    </button>
                </figcaption>
                <pre><code><span class="t-prompt">$</span> <span class="t-cmd">curl</span> <span class="t-flag">-fsSL</span> <span class="t-url">{installUrl}</span> <span class="t-pipe">|</span> <span class="t-cmd">sh</span></code></pre>
            </figure>

            <p class="closing-links">
                <a
                    href="https://github.com/wezel-build/wezel"
                    target="_blank"
                    rel="noopener">Star on GitHub</a
                >
                <span aria-hidden="true"> · </span>
                <a href="/docs/quickstart">Read the quickstart →</a>
            </p>
        </div>
    </section>

    <script is:inline>
        document.querySelectorAll(".install-copy").forEach(function (btn) {
            btn.addEventListener("click", async function () {
                var txt = btn.getAttribute("data-copy") || "";
                var label = btn.querySelector(".install-copy-text");
                try {
                    await navigator.clipboard.writeText(txt);
                } catch (e) {
                    var ta = document.createElement("textarea");
                    ta.value = txt;
                    document.body.appendChild(ta);
                    ta.select();
                    try {
                        document.execCommand("copy");
                    } catch (_) {}
                    document.body.removeChild(ta);
                }
                if (label) {
                    var orig = label.textContent;
                    label.textContent = "copied";
                    btn.classList.add("install-copy-done");
                    setTimeout(function () {
                        label.textContent = orig;
                        btn.classList.remove("install-copy-done");
                    }, 1400);
                }
            });
        });
    </script>
</Base>
