---
import Base from "../layouts/Base.astro";
import Brand from "../components/Brand.astro";
import ContactLinks from "../components/ContactLinks.astro";
import FeaturedPost from "../components/FeaturedPost.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
---

<Base
  bodyClass="homepage"
  title="Wezel - build regression observability"
  description="Wezel keeps watch over build performance as your code changes, tracing regressions and improvements to the commits that introduced them."
>
  <div class="page-tools">
    <ThemeToggle />
  </div>

  <main class="home">
    <section class="fold" aria-label="Wezel">
      <section class="pain" aria-label="Overview">
        <div class="identity">
          <Brand />
        </div>

        <div>
          <h1>
            Your build,
            <span><span class="good-word">always</span> at its best</span>
          </h1>
          <p class="sub">
            Wezel keeps watch over your build performance as your code changes.
            See regressions and improvements, traced to the commits that
            introduced them.
          </p>
        </div>

        <div class="actions">
          <a class="button primary" href="/docs/quickstart">Get started</a>
        </div>

        <article class="extension">
          <h2>Any signal your repo needs.</h2>
          <p>
            Build time, bundle size, or a metric specific to your project.
            Use the built-in measurement tools, or write your own.
          </p>
          <ContactLinks />
        </article>
      </section>

      <div class="home-aside">
      <aside class="evidence" aria-label="Scenario examples" data-scenario-carousel>
        <div class="receipt-rotator">
          <article class="receipt is-active" data-scenario-panel>
            <div>
              <h2>Every regression is attributed.</h2>
              <p class="finding">
                Clean build <strong>regressed</strong>.
              </p>
              <p class="intro">
                Measure selected commits. If a build slows down, Wezel checks
                the commits in between to find where it started.
              </p>
              <pre class="check-card"><code>[step.cargo.clean-build]
args = ["build", "--workspace"]
summary.time.outcome = "time_ms"</code></pre>
            </div>

            <div class="verdict">
              <div class="question-grid">
                <div class="question">
                  <span>measured build</span>
                  <strong>workspace build time</strong>
                </div>
                <div class="question">
                  <span>introducing commit</span>
                  <strong>8f4c2d1</strong>
                </div>
              </div>
              <div class="change">
                <strong>+12.4s</strong>
                <span>compared with last measured run</span>
              </div>
            </div>
          </article>

          <article class="receipt" data-scenario-panel>
            <div>
              <h2>Express your workflow any way you want.</h2>
              <p class="finding">
                Rebuild <strong>regressed</strong>.
              </p>
              <p class="intro">
                Run the base build, apply the patch, then sample the rebuild five
                times.
              </p>
              <pre class="check-card"><code>[step.cargo.base-build]
args = ["build", "--workspace"]

[step.cargo.edit-build]
args = ["build", "--workspace"]
apply_diff = true
summary.time.outcome = "time_ms"
summary.time.aggregation = "mean"
summary.time.samples = 5</code></pre>
            </div>

            <div class="verdict">
              <div class="question-grid">
                <div class="question">
                  <span>measured build</span>
                  <strong>sampled rebuild</strong>
                </div>
                <div class="question">
                  <span>introducing commit</span>
                  <strong>3b91a0f</strong>
                </div>
              </div>
              <div class="change">
                <strong>+2.8s</strong>
                <span>mean of 5 samples</span>
              </div>
            </div>
          </article>

          <article class="receipt" data-scenario-panel>
            <div>
              <h2>Good changes surface too.</h2>
              <p class="finding win">
                WASM size <strong>improved</strong>.
              </p>
              <p class="intro">
                Build your app, then measure the size of the file your users
                download.
              </p>
              <pre class="check-card"><code>[step.exec.build-wasm]
cmd = "trunk build --release"

[step.filesize.measure-wasm]
glob = "dist/app.wasm"
summary.size.outcome = "dist/app.wasm"</code></pre>
            </div>

            <div class="verdict">
              <div class="question-grid">
                <div class="question">
                  <span>measured artifact</span>
                  <strong>dist/app.wasm</strong>
                </div>
                <div class="question">
                  <span>introducing commit</span>
                  <strong>c91a7d4</strong>
                </div>
              </div>
              <div class="change win">
                <strong>-184 KiB</strong>
                <span>compared with last measured run</span>
              </div>
            </div>
          </article>
        </div>

        <div class="scenario-switcher">
          <div class="switcher-label">Examples</div>
          <div class="carousel-controls">
            <div class="scenario-controls" aria-label="Scenarios">
              <button
                class="scenario-control"
                type="button"
                aria-pressed="true"
                data-scenario-control="0"
              >
                <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                  <path d="m3.3 7 8.7 5 8.7-5"></path>
                  <path d="M12 22V12"></path>
                </svg>
                <span>clean</span>
              </button>
              <button
                class="scenario-control"
                type="button"
                aria-pressed="false"
                data-scenario-control="1"
              >
                <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="6" cy="6" r="3"></circle>
                  <circle cx="18" cy="18" r="3"></circle>
                  <path d="M9 6h5a4 4 0 0 1 4 4v5"></path>
                  <path d="M6 9v9h9"></path>
                </svg>
                <span>incremental</span>
              </button>
              <button
                class="scenario-control"
                type="button"
                aria-pressed="false"
                data-scenario-control="2"
              >
                <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5Z"></path>
                  <path d="M14 2v6h6"></path>
                  <path d="M10 13h4"></path>
                  <path d="M10 17h4"></path>
                </svg>
                <span>wasm</span>
              </button>
            </div>
            <button
              class="carousel-toggle"
              type="button"
              aria-pressed="false"
              aria-label="Hold scenario rotation"
              data-carousel-toggle
            >
              <svg class="control-icon pause-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 5v14"></path>
                <path d="M15 5v14"></path>
              </svg>
              <svg class="control-icon play-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 5v14l11-7Z"></path>
              </svg>
            </button>
          </div>
        </div>
      </aside>
      <FeaturedPost />
      </div>
    </section>

  </main>

  <footer class="home-footer">
    <div class="footer-inner">
      <span>&copy; {new Date().getFullYear()} Wezel</span>
      <nav aria-label="Footer">
        <a href="/docs">Docs</a>
        <a href="/blog">Blog</a>
        <a href="https://status.wezel.build">Status</a>
        <a href="https://app.wezel.build">Open app</a>
      </nav>
    </div>
  </footer>

  <style>
    :global(body.homepage) {
      min-height: 100svh;
      display: grid;
      grid-template-rows: 1fr auto;
      align-items: center;
      row-gap: 3rem;
      padding-block: 4rem 1.5rem;
    }

    .home {
      width: min(100%, 81rem);
      margin-inline: auto;
      padding-inline: 3rem;
    }

    .home * {
      border-radius: 0;
      box-shadow: none;
    }

    .identity {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem 1rem;
    }

    .fold {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 4.5rem;
    }

    .pain {
      display: grid;
      grid-template-rows: auto auto auto auto;
      align-content: start;
      gap: 1.75rem;
    }

    h1,
    h2,
    h3 {
      margin: 0;
      text-wrap: balance;
    }

    h1,
    h2 {
      font-family: var(--font-sans);
      font-weight: 720;
    }

    h1 {
      max-width: 18ch;
      font-size: 4rem;
      line-height: 1.04;
      letter-spacing: 0;
    }

    h1 > span {
      display: block;
    }

    .good-word {
      color: var(--color-good);
    }

    .sub {
      max-width: 43ch;
      margin: 1.5rem 0 0;
      color: var(--color-ink-soft);
      font-size: 1.125rem;
      line-height: 1.5;
    }

    .actions {
      align-self: start;
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: center;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 7.5rem;
      min-height: 2.65rem;
      padding: 0.65rem 1rem;
      border: 1px solid var(--color-ink);
      font-weight: 700;
      line-height: 1;
      text-decoration: none;
      transition:
        background 0.16s ease,
        border-color 0.16s ease,
        color 0.16s ease,
        transform 0.16s ease;
    }

    .button.primary {
      background: var(--color-ink);
      color: var(--color-paper);
    }

    .button.primary:hover {
      background: var(--color-ink-deep);
    }

    .button:active {
      transform: translateY(1px);
    }

    .extension {
      width: min(100%, 27rem);
      margin-top: 0.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--color-line-strong);
    }

    .extension h2 {
      max-width: 18ch;
      margin: 0;
      font-size: 2rem;
      line-height: 1.1;
      letter-spacing: 0;
    }

    .extension p {
      max-width: 42ch;
      margin: 0.875rem 0 0;
      color: var(--color-ink-soft);
      font-size: 1rem;
      line-height: 1.5;
    }

    .extension :global(.contact-links) {
      margin-top: 1.25rem;
    }

    .page-tools {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
    }

    .page-tools :global(.theme-toggle) {
      width: 2.5rem;
      height: 2.5rem;
      justify-content: center;
    }

    .page-tools :global(.theme-toggle:focus-visible) {
      outline: 2px solid var(--color-ink);
      outline-offset: 2px;
    }

    .home-aside {
      min-width: 0;
      padding: 0 0 0 2.75rem;
      border-left: 1px solid var(--color-line-strong);
      align-self: stretch;
      display: grid;
      align-content: start;
      gap: 1.75rem;
    }

    .evidence {
      min-width: 0;
      display: grid;
      grid-template-rows: auto auto;
      align-content: start;
      gap: 1.25rem;
    }

    .receipt-rotator {
      display: grid;
      align-self: start;
    }

    .receipt {
      grid-area: 1 / 1;
      display: grid;
      grid-template-rows: 1fr auto;
      gap: 1.5rem;
      min-width: 0;
      opacity: 0;
      visibility: hidden;
      transform: translateY(0.5rem);
      pointer-events: none;
      transition:
        opacity 0.42s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.42s cubic-bezier(0.16, 1, 0.3, 1),
        visibility 0s linear 0.42s;
    }

    .receipt.is-active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
      transition-delay: 0s;
    }

    .receipt > * {
      min-width: 0;
    }

    .evidence h2 {
      max-width: 20ch;
      color: var(--color-ink);
      font-size: 2rem;
      line-height: 1.1;
      letter-spacing: 0;
    }

    .finding {
      margin: 0.65rem 0 0;
      color: var(--color-ink-soft);
      font-family: var(--font-mono);
      font-size: 0.76rem;
      line-height: 1.45;
    }

    .finding strong {
      color: var(--color-warn);
      font-weight: 600;
    }

    .finding.win strong {
      color: var(--color-good);
    }

    .intro {
      max-width: 40ch;
      margin: 0.5rem 0 0;
      color: var(--color-ink-soft);
      font-size: 1rem;
      line-height: 1.45;
    }

    .check-card {
      margin: 1.25rem 0 0;
      padding: 0.75rem 0.9rem;
      border: 1px solid var(--color-line-strong);
      background: color-mix(in srgb, var(--color-paper) 76%, var(--color-chrome));
      color: var(--color-ink);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      line-height: 1.45;
      max-width: 100%;
      min-width: 0;
      overflow-x: auto;
    }

    .check-card code {
      font-family: inherit;
    }

    .verdict {
      border-top: 1px solid var(--color-line-strong);
      border-bottom: 1px solid var(--color-line-strong);
      padding-block: 1rem;
    }

    .question-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0;
      margin-bottom: 1.1rem;
      border-bottom: 1px solid var(--color-line);
    }

    .question {
      padding: 0 1.15rem 1rem 0;
    }

    .question + .question {
      padding-left: 1.15rem;
      border-left: 1px solid var(--color-line);
    }

    .question span {
      display: block;
      color: var(--color-ink-faint);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      line-height: 1.45;
    }

    .question strong {
      display: block;
      margin-top: 0.45rem;
      font-size: 1.25rem;
      line-height: 1.05;
      letter-spacing: 0;
    }

    .change {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      column-gap: 0.75rem;
      row-gap: 0.15rem;
      color: var(--color-warn);
      font-family: var(--font-mono);
    }

    .change.win {
      color: var(--color-good);
    }

    .change strong {
      flex: 0 0 auto;
      font-size: 1.5rem;
      line-height: 1;
      letter-spacing: 0;
    }

    .change span {
      max-width: 20ch;
      color: var(--color-ink-faint);
      font-size: 0.72rem;
      line-height: 1.35;
    }

    .scenario-switcher {
      align-self: start;
      justify-self: stretch;
      display: grid;
      gap: 0.5rem;
      width: 100%;
    }

    .switcher-label {
      color: var(--color-ink-faint);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      line-height: 1;
    }

    .carousel-controls {
      display: flex;
      align-items: stretch;
      gap: 0.5rem;
      width: 100%;
    }

    .scenario-controls {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      flex: 1 1 0;
      min-width: 0;
      border: 1px solid var(--color-line-strong);
      background: color-mix(in srgb, var(--color-surface) 82%, var(--color-chrome));
    }

    .scenario-control,
    .carousel-toggle {
      position: relative;
      isolation: isolate;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.38rem;
      min-height: 2rem;
      border: 0;
      padding: 0.45rem 0.75rem;
      background: transparent;
      color: var(--color-ink-soft);
      cursor: pointer;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      line-height: 1;
      white-space: nowrap;
      min-width: 0;
      overflow: hidden;
      transition:
        color 0.18s ease,
        transform 0.18s ease;
    }

    .scenario-control + .scenario-control {
      border-left: 1px solid var(--color-line);
    }

    .carousel-toggle {
      flex: 0 0 2.4rem;
      width: 2.4rem;
      border: 1px solid var(--color-line-strong);
      background: color-mix(in srgb, var(--color-surface) 82%, var(--color-chrome));
      padding-inline: 0;
    }

    .scenario-control::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 0;
      background: var(--color-progress);
      opacity: 0;
      transform: scaleX(var(--scenario-progress, 0));
      transform-origin: left center;
      transition:
        opacity 0.18s ease,
        transform 0.09s linear;
    }

    .control-icon,
    .scenario-control span {
      position: relative;
      z-index: 1;
    }

    .scenario-control span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .control-icon {
      width: 0.82rem;
      height: 0.82rem;
      flex: 0 0 auto;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .carousel-toggle .play-icon {
      display: none;
    }

    .carousel-toggle[aria-pressed="true"] .pause-icon {
      display: none;
    }

    .carousel-toggle[aria-pressed="true"] .play-icon {
      display: block;
    }

    .scenario-control:hover,
    .carousel-toggle:hover,
    .scenario-control[aria-pressed="true"] {
      color: var(--color-ink);
    }

    .scenario-control:focus,
    .carousel-toggle:focus {
      outline: none;
    }

    .scenario-control:focus-visible,
    .carousel-toggle:focus-visible {
      outline: 1px solid var(--color-accent);
      outline-offset: -1px;
    }

    .scenario-control:active,
    .carousel-toggle:active {
      transform: translateY(1px);
    }

    .scenario-control[aria-pressed="true"]::before {
      opacity: 1;
    }

    .carousel-toggle[aria-pressed="true"] {
      background: var(--color-veil);
      color: var(--color-ink);
    }

    .home-footer {
      width: min(100%, 81rem);
      margin-inline: auto;
      padding-inline: 3rem;
      color: var(--color-ink-faint);
      font-size: 0.8125rem;
    }

    .footer-inner {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      border-top: 1px solid var(--color-line);
      padding-top: 1.25rem;
    }

    .home-footer nav {
      display: flex;
      flex-wrap: wrap;
      gap: 1.25rem;
    }

    .home-footer a {
      color: inherit;
      text-decoration: none;
    }

    .home-footer a:hover {
      color: var(--color-ink);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    .home-footer a:focus-visible {
      outline: 2px solid var(--color-ink);
      outline-offset: 4px;
    }

    @media (max-width: 65rem) {
      :global(body.homepage) {
        padding-block: 3.75rem 1.5rem;
      }

      .home,
      .home-footer {
        width: min(100%, 42rem);
        padding-inline: 2rem;
      }

      .fold {
        grid-template-columns: minmax(0, 1fr);
        gap: 2.5rem;
      }

      .home-aside {
        padding: 2.25rem 0 0;
        border-left: 0;
        border-top: 1px solid var(--color-line-strong);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .receipt {
        opacity: 0;
        transform: none;
        transition: none;
      }

      .receipt.is-active {
        opacity: 1;
        visibility: visible;
      }

      .scenario-control,
      .carousel-toggle,
      .button {
        transition: none;
      }

      .scenario-control[aria-pressed="true"]::before {
        transform: scaleX(1);
      }
    }

    @media (max-width: 48rem) {
      .home,
      .home-footer {
        padding-inline: 1.25rem;
      }

      .pain {
        gap: 1.5rem;
      }

      .home-aside {
        padding: 2rem 0 0;
      }

      h1 {
        max-width: 12.5ch;
        font-size: 2.875rem;
      }

      .sub {
        font-size: 1.05rem;
      }

      .extension h2 {
        max-width: 100%;
        font-size: 2rem;
      }

      .evidence h2 {
        font-size: 2rem;
      }

      .check-card {
        padding-inline: 0.65rem;
      }

      .scenario-switcher {
        max-width: 100%;
        width: 100%;
      }

      .carousel-controls {
        gap: 0.38rem;
      }

      .scenario-controls {
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.5fr) minmax(0, 0.9fr);
        overflow: hidden;
      }

      .scenario-control {
        gap: 0.32rem;
        padding-inline: 0.45rem;
        font-size: 0.68rem;
      }

      .carousel-toggle {
        flex-basis: 2.15rem;
        width: 2.15rem;
      }

      .control-icon {
        width: 0.75rem;
        height: 0.75rem;
      }

    }
  </style>

  <script>
    (() => {
      const carousel = document.querySelector("[data-scenario-carousel]");
      if (!carousel) return;

      const panels = Array.from(
        carousel.querySelectorAll("[data-scenario-panel]"),
      );
      const controls = Array.from(
        carousel.querySelectorAll("[data-scenario-control]"),
      );
      const toggle = carousel.querySelector("[data-carousel-toggle]");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let activeIndex = panels.findIndex((panel) =>
        panel.classList.contains("is-active"),
      );
      const cycleMs = 6200;
      let timer = null;
      let progressTimer = null;
      let startedAt = 0;
      let remainingMs = cycleMs;
      const holdReasons = new Set();

      if (activeIndex < 0) activeIndex = 0;

      function updateToggle() {
        if (!toggle) return;
        const manuallyHeld = holdReasons.has("manual");
        toggle.setAttribute("aria-pressed", String(manuallyHeld));
        toggle.setAttribute(
          "aria-label",
          manuallyHeld ? "Resume scenario rotation" : "Hold scenario rotation",
        );
      }

      function showScenario(index) {
        if (!panels[index] || index === activeIndex) return;
        panels[activeIndex].classList.remove("is-active");
        controls[activeIndex].setAttribute("aria-pressed", "false");
        controls[activeIndex].style.setProperty("--scenario-progress", "0");
        panels[index].classList.add("is-active");
        controls[index].setAttribute("aria-pressed", "true");
        controls[index].style.setProperty("--scenario-progress", "0");
        activeIndex = index;
        remainingMs = cycleMs;
      }

      function clearTimer() {
        if (timer) window.clearTimeout(timer);
        timer = null;
      }

      function clearProgressTimer() {
        if (progressTimer) window.clearInterval(progressTimer);
        progressTimer = null;
      }

      function setProgress(value) {
        controls[activeIndex].style.setProperty(
          "--scenario-progress",
          String(Math.min(1, Math.max(0, value))),
        );
      }

      function startProgress(delay) {
        clearProgressTimer();
        if (reduceMotion.matches) {
          setProgress(1);
          return;
        }

        const startingProgress = 1 - delay / cycleMs;
        const tick = () => {
          const elapsed = performance.now() - startedAt;
          setProgress(startingProgress + elapsed / cycleMs);
        };
        tick();
        progressTimer = window.setInterval(tick, 80);
      }

      function holdClock() {
        if (timer) {
          const elapsed = performance.now() - startedAt;
          remainingMs = Math.max(300, remainingMs - elapsed);
        }
        clearTimer();
        clearProgressTimer();
        setProgress(1 - remainingMs / cycleMs);
      }

      function addHold(reason) {
        const wasRunning = holdReasons.size === 0;
        holdReasons.add(reason);
        if (wasRunning) holdClock();
        updateToggle();
      }

      function removeHold(reason) {
        holdReasons.delete(reason);
        updateToggle();
        if (holdReasons.size === 0) schedule();
      }

      function schedule(delay = remainingMs) {
        clearTimer();
        clearProgressTimer();
        if (reduceMotion.matches || holdReasons.size > 0) return;
        remainingMs = Math.max(300, delay);
        startedAt = performance.now();
        startProgress(remainingMs);
        timer = window.setTimeout(() => {
          clearProgressTimer();
          showScenario((activeIndex + 1) % panels.length);
          schedule(cycleMs);
        }, remainingMs);
      }

      function restart() {
        remainingMs = cycleMs;
        setProgress(reduceMotion.matches ? 1 : 0);
        schedule(cycleMs);
      }

      controls.forEach((control) => {
        control.addEventListener("click", () => {
          const nextIndex = Number(control.dataset.scenarioControl);
          showScenario(nextIndex);
          if (holdReasons.size > 0) {
            setProgress(1);
          } else {
            restart();
          }
        });
      });

      if (toggle) {
        toggle.addEventListener("click", () => {
          if (holdReasons.has("manual")) {
            holdReasons.clear();
            updateToggle();
            schedule();
          } else {
            addHold("manual");
          }
        });
      }

      carousel.addEventListener("mouseenter", () => addHold("hover"));
      carousel.addEventListener("mouseleave", () => removeHold("hover"));
      carousel.addEventListener("focusin", () => addHold("focus"));
      carousel.addEventListener("focusout", () => removeHold("focus"));
      if (reduceMotion.addEventListener) {
        reduceMotion.addEventListener("change", restart);
      } else {
        reduceMotion.addListener(restart);
      }
      restart();
    })();
  </script>
</Base>
