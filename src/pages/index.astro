  /* Cursor positions (commit i center ≈ 4 + i·14.75 + 7.375):
       commit  4 ≈  70.4px   commit 20 ≈ 306.4px
       commit 11 ≈ 173.6px   commit 22 ≈ 335.9px
       commit 13 ≈ 203.1px   commit 23 ≈ 350.6px
       commit 17 ≈ 262.1px   commit 24 ≈ 365.4px
       sweep-end (right edge) = 476px.
     Percentages are out of 8000ms total. Sweep phase ends at 4600ms (57.5%);
     each of the 4 sample-pauses is 150ms inserted into that phase. The cursor
     then holds at the right edge while the bisection-range bracket draws
     right-to-left and the label appears, before jumping back to each step. */
  @keyframes cursor-sweep {
    0%      { transform: translate(4px, 0);       opacity: 0; }
    1%      {                                     opacity: 1; }
    7%      { transform: translate(70.4px, 0);                }  /* 562ms — reach commit 4 */
    8.9%    { transform: translate(70.4px, 0);                }  /* 712ms — end pause 1 */
    19.8%   { transform: translate(173.6px, 0);               }  /* 1587ms — reach commit 11 */
    21.7%   { transform: translate(173.6px, 0);               }  /* 1737ms — end pause 2 */
    24.8%   { transform: translate(203.1px, 0);               }  /* 1987ms — reach commit 13 */
    26.7%   { transform: translate(203.1px, 0);               }  /* 2137ms — end pause 3 */
    33%     { transform: translate(262.1px, 0);               }  /* 2637ms — reach commit 17 */
    34.8%   { transform: translate(262.1px, 0);               }  /* 2787ms — end pause 4 */
    57.5%   { transform: translate(476px, 0);                 }  /* 4600ms — end of sweep */
    72.5%   { transform: translate(476px, 0);                 }  /* 5800ms — hold while bisection-range bracket draws RTL + label appears */
    73.1%   { transform: translate(365.4px, 0);               }  /* 5850ms — jump to commit 24 (bisect step 1) */
    78.1%   { transform: translate(365.4px, 0);               }  /* 6250ms — hold */
    78.4%   { transform: translate(306.4px, 0);               }  /* 6275ms — jump back to commit 20 (step 2) */
    83.4%   { transform: translate(306.4px, 0);               }  /* 6675ms — hold */
    83.8%   { transform: translate(335.9px, 0);               }  /* 6700ms — jump right to commit 22 (step 3) */
    88.8%   { transform: translate(335.9px, 0);               }  /* 7100ms — hold */
    89.1%   { transform: translate(350.6px, 0);               }  /* 7125ms — jump to commit 23 (step 4 — offender) */
    91.9%   { transform: translate(350.6px, 0);   opacity: 1; }  /* 7350ms — hold */
    94.4%   { transform: translate(350.6px, 0);   opacity: 0; }  /* 7550ms — fade out as marker takes over */
    100%    { transform: translate(350.6px, 0);   opacity: 0; }
