---
import Base from '../layouts/Base.astro';
import { Code } from 'astro:components';

const installUrl = new URL('install.sh', Astro.site ?? 'https://wezel-build.github.io/').toString();
const installCmd = `curl -fsSL ${installUrl} | sh`;

const experimentToml = `description = "Tracks compile time of the wezel workspace"

# Steps are keyed [step.<tool>.<step_name>].
# The cargo tool builds your target and emits per-crate timing outcomes.
[step.cargo.build]
build_target = "workspace"

# A single outcome can feed multiple summaries — Wezel tracks each independently.
summary.workspace-build-time = { outcome = "duration.total" }
summary.slowest-crate-time   = { outcome = "duration.max" }
`;

// Build-time samples (seconds), last 32 commits, dev build of a Rust workspace.
// Bars 0..24 are baseline (~47s), bars 25..31 show the +12.4s regression.
const samples = [
  47.1, 47.8, 47.4, 46.9, 47.2, 47.6, 47.5, 47.0,
  47.3, 47.9, 47.2, 46.8, 47.7, 47.4, 47.1, 47.5,
  47.8, 47.3, 47.0, 47.6, 47.4, 46.9, 47.5, 48.0,
  47.2,
  59.7, 59.3, 58.9, 59.5, 59.8, 59.4, 59.1,
];

const W = 480;
const H = 200;
const PAD_X = 4;
const N = samples.length;
const slot = (W - PAD_X * 2) / N;
const barW = slot * 0.62;
const baseY = 165;             // y position of build = 0
const scale = 2.1;             // px per second above 0
const regressionIdx = 25;
---

<Base>
  <!-- ── Hero ──────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-rule hero-rule-top"></div>
    <div class="hero-glow"></div>

    <div class="hero-inner">
      <div class="hero-copy">
        <p class="section-label hero-anim" style="--d:0ms">
          Build-time observability · open source
        </p>
        <h1 class="hero-title hero-anim" style="--d:120ms">
          Build performance drifts.<br />
          Nudge yours in the right direction.
        </h1>
        <p class="hero-sub hero-anim" style="--d:240ms">
          Wezel benchmarks the build scenarios your team runs most, on every commit.
          When something gets slower, the offending change, the delta, and the affected scope
          surface immediately.
        </p>
        <div class="hero-ctas hero-anim" style="--d:360ms">
          <a href="https://github.com/wezel-build/wezel" class="btn btn-lg btn-primary" target="_blank" rel="noopener">
            Get started
          </a>
          <a href="/docs" class="btn btn-lg btn-ghost-line">
            Read the docs <span aria-hidden="true">→</span>
          </a>
        </div>

        <figure class="install-snippet hero-install hero-anim" style="--d:520ms">
          <figcaption>
            <span class="install-shell">shell</span>
            <button class="install-copy" type="button" data-copy={installCmd} aria-label="Copy install command">
              <span class="install-copy-text">copy</span>
            </button>
          </figcaption>
          <pre><code><span class="t-prompt">$</span> <span class="t-cmd">curl</span> <span class="t-flag">-fsSL</span> <span class="t-url">{installUrl}</span> <span class="t-pipe">|</span> <span class="t-cmd">sh</span></code></pre>
        </figure>
      </div>

      <figure class="hero-chart hero-anim" style="--d:480ms">
        <header class="chart-head">
          <span class="chart-head-key">build duration · seconds</span>
          <span class="chart-head-dot" aria-hidden="true"></span>
          <span class="chart-head-key chart-head-key-right">live</span>
        </header>

        <svg
          class="chart-svg"
          viewBox={`0 0 ${W} ${H}`}
          preserveAspectRatio="none"
          role="img"
          aria-label="Build durations over the last 32 commits, with a regression on commit a3f8c1d adding 12.4 seconds."
        >
          <defs>
            <linearGradient id="bar-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--text-mid)" stop-opacity="0.95" />
              <stop offset="100%" stop-color="var(--text-mid)" stop-opacity="0.55" />
            </linearGradient>
            <linearGradient id="bar-grad-warn" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--red)" stop-opacity="1" />
              <stop offset="100%" stop-color="var(--red)" stop-opacity="0.6" />
            </linearGradient>
          </defs>

          <!-- horizontal hairlines -->
          {[20, 40, 60].map((s) => (
            <line
              x1={PAD_X} y1={baseY - s * scale}
              x2={W - PAD_X} y2={baseY - s * scale}
              class="grid-line"
            />
          ))}

          <!-- baseline of 47.3s -->
          <line
            x1={PAD_X} y1={baseY - 47.3 * scale}
            x2={W - PAD_X} y2={baseY - 47.3 * scale}
            class="baseline-line"
            stroke-dasharray="2 4"
          />
          <text
            x={W - PAD_X} y={baseY - 47.3 * scale - 6}
            class="axis-label axis-label-right"
          >baseline 47.3s</text>

          <!-- bars -->
          {samples.map((s, i) => {
            const x = PAD_X + i * slot + (slot - barW) / 2;
            const h = s * scale;
            const y = baseY - h;
            const isWarn = i >= regressionIdx;
            return (
              <rect
                class={`bar${isWarn ? ' bar-warn' : ''}`}
                x={x} y={y} width={barW} height={h}
                rx={1}
                style={`--d:${600 + i * 28}ms`}
                fill={isWarn ? 'url(#bar-grad-warn)' : 'url(#bar-grad)'}
              />
            );
          })}

          <!-- regression marker line -->
          <line
            x1={PAD_X + regressionIdx * slot - 1}
            y1={20}
            x2={PAD_X + regressionIdx * slot - 1}
            y2={baseY + 6}
            class="marker-line"
          />

          <!-- regression annotation -->
          <g class="marker-label" transform={`translate(${PAD_X + regressionIdx * slot + 8}, 28)`}>
            <text class="marker-hash">a3f8c1d</text>
            <text class="marker-delta" y="13">+12.4s · +26%</text>
          </g>

          <!-- ticks under axis -->
          <line x1={PAD_X} y1={baseY + 1} x2={W - PAD_X} y2={baseY + 1} class="axis-line" />
          <text x={PAD_X} y={baseY + 16} class="axis-label">32 commits ago</text>
          <text x={W - PAD_X} y={baseY + 16} class="axis-label axis-label-right">now</text>
        </svg>
      </figure>
    </div>

    <div class="hero-rule hero-rule-bot"></div>
  </section>

  <!-- ── Stats strip ───────────────────────────────────── -->
  <aside class="stats-strip" aria-label="Project facts">
    <div class="stats-inner">
      <span class="stat"><span class="stat-key">license</span> MIT</span>
      <span class="stat"><span class="stat-key">runtime</span> Rust · single binary</span>
      <span class="stat"><span class="stat-key">deployment</span> self-host · zero cloud dependency</span>
      <span class="stat"><span class="stat-key">status</span> <span class="stat-active">v0.1 · active development</span></span>
    </div>
  </aside>

  <!-- ── Example experiment ───────────────────────────── -->
  <section class="example">
    <div class="example-inner">
      <p class="section-label">An example</p>
      <h2 class="section-title">From TOML to alert.</h2>

      <ol class="example-steps">
        <li class="example-step">
          <header class="step-head">
            <span class="step-num">01</span>
            <div class="step-text">
              <h3>Define a scenario.</h3>
              <p>An <code>experiment.toml</code> committed alongside your code declares what Wezel measures.</p>
            </div>
          </header>
          <figure class="example-code">
            <figcaption>
              <span class="example-path">.wezel/experiments/workspace-build/experiment.toml</span>
              <span class="example-lang">toml</span>
            </figcaption>
            <Code code={experimentToml} lang="toml" theme="vitesse-dark" />
          </figure>
        </li>

        <li class="example-step">
          <header class="step-head">
            <span class="step-num">02</span>
            <div class="step-text">
              <h3>Observe a regression.</h3>
              <p>The CLI walks the steps, captures outcomes, and compares each summary against the trailing baseline.</p>
            </div>
          </header>
          <figure class="example-terminal">
            <figcaption>
              <span class="example-shell">shell</span>
            </figcaption>
            <pre><code><span class="t-prompt">$</span> <span class="t-cmd">wezel</span> experiment run workspace-build
<span class="t-dim">→ step.cargo.build  ...........  59.7s</span>
<span class="t-dim">→ summary.workspace-build-time   59.7s   (baseline 47.3s · </span><span class="t-warn">+12.4s · regression</span><span class="t-dim">)</span>
<span class="t-dim">→ summary.slowest-crate-time      8.4s   (baseline  8.1s · +0.3s)</span>
<span class="t-dim">done in 59.9s</span></code></pre>
          </figure>
        </li>

        <li class="example-step">
          <header class="step-head">
            <span class="step-num">03</span>
            <div class="step-text">
              <h3>Track it in CI.</h3>
              <p>Wired into anything that runs per commit — CI, a build server, a cron — Wezel emits the alert the moment a summary drifts past tolerance.</p>
            </div>
          </header>
          <figure class="example-alert">
            <figcaption>
              <span class="example-alert-tag">⚠ regression detected</span>
              <span class="example-alert-ts">2026-05-15</span>
            </figcaption>
            <dl class="alert-fields">
              <div><dt>experiment</dt><dd>workspace-build</dd></div>
              <div><dt>summary</dt><dd>workspace-build-time</dd></div>
              <div><dt>commit</dt><dd class="alert-hash">a3f8c1d</dd></div>
              <div><dt>baseline</dt><dd>47.3s · trailing 30 commits</dd></div>
              <div><dt>current</dt><dd class="alert-warn">59.7s · +12.4s · +26%</dd></div>
            </dl>
          </figure>
        </li>
      </ol>
    </div>
  </section>

  <!-- ── Closing CTA ──────────────────────────────────── -->
  <section class="bottom-cta">
    <div class="bottom-cta-glow"></div>
    <div class="bottom-cta-inner">
      <p class="section-label">Get started</p>
      <h2 class="bottom-cta-title">Run it <em>locally.</em></h2>
      <div class="bottom-cta-buttons">
        <a href="https://github.com/wezel-build/wezel" class="btn btn-lg btn-primary" target="_blank" rel="noopener">
          Star on GitHub
        </a>
        <a href="/docs/quickstart" class="btn btn-lg btn-ghost-line">
          Read the quickstart <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      document.querySelectorAll('.install-copy').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          var txt = btn.getAttribute('data-copy') || '';
          var label = btn.querySelector('.install-copy-text');
          try { await navigator.clipboard.writeText(txt); }
          catch (e) {
            var ta = document.createElement('textarea');
            ta.value = txt; document.body.appendChild(ta); ta.select();
            try { document.execCommand('copy'); } catch (_) {}
            document.body.removeChild(ta);
          }
          if (label) {
            var orig = label.textContent;
            label.textContent = 'copied';
            btn.classList.add('install-copy-done');
            setTimeout(function () {
              label.textContent = orig;
              btn.classList.remove('install-copy-done');
            }, 1400);
          }
        });
      });
    })();
  </script>
</Base>

<style is:global>
  /* ── Hero ───────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 4.5rem 0 2rem;
  }

  .hero-rule {
    position: absolute;
    left: 2rem;
    right: 2rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-light) 20%, var(--border-light) 80%, transparent);
    opacity: 0.5;
  }
  .hero-rule-top { top: 0; }
  .hero-rule-bot { bottom: 0; }

  .hero-glow {
    position: absolute;
    top: -200px;
    right: -120px;
    width: 720px;
    height: 520px;
    background: radial-gradient(ellipse at center, var(--accent-glow-strong) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 2rem 3rem;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 3.5rem;
    align-items: center;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.4rem, 4.4vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--text);
    margin: 0 0 1.5rem;
  }

  .hero-title em,
  .accent-mark {
    font-style: normal;
    color: var(--accent);
    background-image: linear-gradient(
      0deg,
      var(--accent-glow-strong) 0%,
      var(--accent-glow-strong) 28%,
      transparent 28%
    );
    padding: 0 0.12em;
    margin: 0 -0.04em;
  }

  .hero-sub {
    font-size: 1.05rem;
    color: var(--text-mid);
    line-height: 1.65;
    max-width: 38ch;
    margin: 0 0 2rem;
  }

  .hero-ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 2.75rem;
  }

  .btn-ghost-line {
    background: transparent;
    color: var(--text);
    border: none;
    padding: 0.85rem 0.5rem;
    position: relative;
  }
  .btn-ghost-line::after {
    content: "";
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0.6rem;
    height: 1px;
    background: var(--text-dim);
    transform-origin: left;
    transform: scaleX(0.4);
    transition: transform 0.25s ease, background 0.25s ease;
  }
  .btn-ghost-line:hover::after {
    transform: scaleX(1);
    background: var(--accent);
  }

  /* Hero install snippet (lighter than the bottom version) */
  .hero-install {
    margin: 0;
    max-width: 100%;
    box-shadow:
      0 6px 24px rgba(0, 0, 0, 0.28),
      0 0 30px var(--accent-glow);
  }
  .hero-install pre {
    font-size: 0.82rem;
    padding: 0.95rem 1.1rem;
  }
  .hero-install figcaption {
    padding: 0.45rem 0.9rem;
  }

  /* Stats strip */
  .stats-strip {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--bg-deep);
    overflow-x: auto;
  }
  .stats-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.75rem 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2.25rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text);
  }
  .stat {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    white-space: nowrap;
  }
  .stat-key {
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .stat-active {
    color: var(--green);
  }
  .stat-active::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px var(--green);
    vertical-align: 1px;
    animation: pulse 1.8s ease-in-out infinite;
  }

  /* ── Chart ────────────────────────────────────────── */
  .hero-chart {
    position: relative;
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg-deep) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1rem 1.1rem 1.1rem;
    margin: 0;
    box-shadow:
      0 16px 48px rgba(0, 0, 0, 0.4),
      0 0 80px var(--accent-glow);
  }

  .chart-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px dashed var(--border);
    margin-bottom: 0.85rem;
  }
  .chart-head-key {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .chart-head-key-right {
    margin-left: auto;
    color: var(--green);
  }
  .chart-head-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    margin-left: auto;
    box-shadow: 0 0 8px var(--green);
    animation: pulse 1.8s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }

  .chart-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .chart-svg .grid-line {
    stroke: var(--border);
    stroke-width: 1;
    opacity: 0.7;
  }
  .chart-svg .baseline-line {
    stroke: var(--accent);
    stroke-width: 1;
    opacity: 0.55;
  }
  .chart-svg .axis-line {
    stroke: var(--border-light);
    stroke-width: 1;
  }
  .chart-svg .axis-label {
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: var(--text-dim);
  }
  .chart-svg .axis-label-right {
    text-anchor: end;
  }
  .chart-svg .bar {
    transform-origin: center bottom;
    transform-box: fill-box;
    animation: bar-grow 700ms cubic-bezier(.16,.7,.27,1) var(--d, 0ms) backwards;
  }
  .chart-svg .marker-line {
    stroke: var(--red);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    opacity: 0;
    animation: fade-in 500ms 1450ms forwards;
  }
  .chart-svg .marker-label {
    opacity: 0;
    animation: rise 600ms 1550ms backwards forwards;
  }
  .chart-svg .marker-hash {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    fill: var(--red);
    letter-spacing: 0.02em;
  }
  .chart-svg .marker-delta {
    font-family: var(--font-mono);
    font-size: 9.5px;
    fill: var(--text);
    letter-spacing: 0.01em;
  }
  .chart-svg .marker-cause {
    font-family: var(--font-mono);
    font-size: 8.5px;
    fill: var(--text-dim);
    letter-spacing: 0.02em;
  }

  @keyframes bar-grow {
    from { transform: scaleY(0); opacity: 0; }
    to { transform: scaleY(1); opacity: 1; }
  }
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes rise {
    from { opacity: 0; transform: translate(var(--rx, 0), 6px); }
    to { opacity: 1; transform: translate(0, 0); }
  }

  /* Hero copy stagger animation */
  .hero-anim {
    opacity: 0;
    animation: hero-rise 700ms cubic-bezier(.2,.7,.27,1) var(--d, 0ms) forwards;
  }
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Section shared ────────────────────────────────── */
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.05em;
    line-height: 1.1;
    margin: 0 0 2.5rem;
    max-width: 24ch;
  }

  .section-title em {
    font-style: normal;
    color: var(--accent);
    background-image: linear-gradient(
      0deg,
      var(--accent-glow-strong) 0%,
      var(--accent-glow-strong) 28%,
      transparent 28%
    );
    padding: 0 0.1em;
    margin: 0 -0.04em;
  }

  /* ── Scope ────────────────────────────────────────── */
  .scope {
    padding: 5rem 0;
    border-top: 1px solid var(--border);
  }

  .scope-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .scope-list {
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    max-width: 60rem;
    border-top: 1px solid var(--border);
  }

  .scope-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 2.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }

  .scope-item dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--text);
    letter-spacing: -0.04em;
    margin: 0;
    line-height: 1.2;
  }

  .scope-item dd {
    margin: 0;
    font-size: 0.96rem;
    color: var(--text-mid);
    line-height: 1.7;
    max-width: 60ch;
  }

  /* ── Example experiment ────────────────────────────── */
  .example {
    position: relative;
    padding: 5.5rem 0 5rem;
    border-top: 1px solid var(--border);
  }

  .example-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Three-step sequence */
  .example-steps {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: 64rem;
  }

  .example-step {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }

  .step-head {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  .step-num {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.1rem;
    color: var(--accent);
    letter-spacing: -0.04em;
    line-height: 1;
    padding-top: 0.25rem;
  }
  .step-num::after {
    content: "";
    display: block;
    width: 28px;
    height: 1px;
    background: var(--accent);
    opacity: 0.6;
    margin-top: 0.55rem;
  }

  .step-text h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--text);
    letter-spacing: -0.04em;
    margin: 0 0 0.4rem;
    line-height: 1.2;
  }
  .step-text p {
    font-size: 0.96rem;
    color: var(--text-mid);
    line-height: 1.65;
    max-width: 60ch;
