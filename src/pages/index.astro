---
import Base from '../layouts/Base.astro';
import { Code } from 'astro:components';

const experimentToml = `description = "Tracks compile time of the wezel workspace"

# Steps are keyed [step.<tool>.<step_name>].
# The cargo tool builds your target and emits per-crate timing outcomes.
[step.cargo.build]
build_target = "workspace"

# A single outcome can feed multiple summaries — Wezel tracks each independently.
summary.workspace-build-time = { outcome = "duration.total" }
summary.slowest-crate-time   = { outcome = "duration.max" }
`;

// Build-time samples (seconds), last 32 commits, dev build of a Rust workspace.
// Bars 0..24 are baseline (~47s), bars 25..31 show the +12.4s regression.
const samples = [
  47.1, 47.8, 47.4, 46.9, 47.2, 47.6, 47.5, 47.0,
  47.3, 47.9, 47.2, 46.8, 47.7, 47.4, 47.1, 47.5,
  47.8, 47.3, 47.0, 47.6, 47.4, 46.9, 47.5, 48.0,
  47.2,
  59.7, 59.3, 58.9, 59.5, 59.8, 59.4, 59.1,
];

const W = 480;
const H = 200;
const PAD_X = 4;
const N = samples.length;
const slot = (W - PAD_X * 2) / N;
const barW = slot * 0.62;
const baseY = 165;             // y position of build = 0
const scale = 2.1;             // px per second above 0
const regressionIdx = 25;
---

<Base>
  <!-- ── Hero ──────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-rule hero-rule-top"></div>
    <div class="hero-glow"></div>

    <div class="hero-inner">
      <div class="hero-copy">
        <p class="section-label hero-anim" style="--d:0ms">
          Build-time observability · open source
        </p>
        <h1 class="hero-title hero-anim" style="--d:120ms">
          Get <em>intentional</em><br />
          about build speed.
        </h1>
        <p class="hero-sub hero-anim" style="--d:240ms">
          Wezel benchmarks the build scenarios your team runs most, on every commit.
          The moment something gets slower, you know which change, how much, and what it touched.
        </p>
        <div class="hero-ctas hero-anim" style="--d:360ms">
          <a href="https://github.com/wezel-build/wezel" class="btn btn-lg btn-primary" target="_blank" rel="noopener">
            Get started
          </a>
          <a href="/docs" class="btn btn-lg btn-ghost-line">
            Read the docs <span aria-hidden="true">→</span>
          </a>
        </div>

        <dl class="hero-meta hero-anim" style="--d:520ms">
          <div>
            <dt>scenario</dt>
            <dd>cargo&nbsp;build · dev</dd>
          </div>
          <div>
            <dt>window</dt>
            <dd>last 32 commits</dd>
          </div>
          <div>
            <dt>regression</dt>
            <dd class="meta-warn">+12.4s · +26%</dd>
          </div>
        </dl>
      </div>

      <figure class="hero-chart hero-anim" style="--d:480ms">
        <header class="chart-head">
          <span class="chart-head-key">build duration · seconds</span>
          <span class="chart-head-dot" aria-hidden="true"></span>
          <span class="chart-head-key chart-head-key-right">live</span>
        </header>

        <svg
          class="chart-svg"
          viewBox={`0 0 ${W} ${H}`}
          preserveAspectRatio="none"
          role="img"
          aria-label="Build durations over the last 32 commits, with a regression on commit a3f8c1d adding 12.4 seconds."
        >
          <defs>
            <linearGradient id="bar-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--text-mid)" stop-opacity="0.95" />
              <stop offset="100%" stop-color="var(--text-mid)" stop-opacity="0.55" />
            </linearGradient>
            <linearGradient id="bar-grad-warn" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--red)" stop-opacity="1" />
              <stop offset="100%" stop-color="var(--red)" stop-opacity="0.6" />
            </linearGradient>
          </defs>

          <!-- horizontal hairlines -->
          {[20, 40, 60].map((s) => (
            <line
              x1={PAD_X} y1={baseY - s * scale}
              x2={W - PAD_X} y2={baseY - s * scale}
              class="grid-line"
            />
          ))}

          <!-- baseline of 47.3s -->
          <line
            x1={PAD_X} y1={baseY - 47.3 * scale}
            x2={W - PAD_X} y2={baseY - 47.3 * scale}
            class="baseline-line"
            stroke-dasharray="2 4"
          />
          <text
            x={W - PAD_X} y={baseY - 47.3 * scale - 6}
            class="axis-label axis-label-right"
          >baseline 47.3s</text>

          <!-- bars -->
          {samples.map((s, i) => {
            const x = PAD_X + i * slot + (slot - barW) / 2;
            const h = s * scale;
            const y = baseY - h;
            const isWarn = i >= regressionIdx;
            return (
              <rect
                class={`bar${isWarn ? ' bar-warn' : ''}`}
                x={x} y={y} width={barW} height={h}
                rx={1}
                style={`--d:${600 + i * 28}ms`}
                fill={isWarn ? 'url(#bar-grad-warn)' : 'url(#bar-grad)'}
              />
            );
          })}

          <!-- regression marker line -->
          <line
            x1={PAD_X + regressionIdx * slot - 1}
            y1={20}
            x2={PAD_X + regressionIdx * slot - 1}
            y2={baseY + 6}
            class="marker-line"
          />

          <!-- regression annotation -->
          <g class="marker-label" transform={`translate(${PAD_X + regressionIdx * slot + 8}, 28)`}>
            <text class="marker-hash">a3f8c1d</text>
            <text class="marker-delta" y="13">+12.4s · +26%</text>
            <text class="marker-cause" y="26">core::parser · new generic impl</text>
          </g>

          <!-- ticks under axis -->
          <line x1={PAD_X} y1={baseY + 1} x2={W - PAD_X} y2={baseY + 1} class="axis-line" />
          <text x={PAD_X} y={baseY + 16} class="axis-label">32 commits ago</text>
          <text x={W - PAD_X} y={baseY + 16} class="axis-label axis-label-right">now</text>
        </svg>
      </figure>
    </div>

    <div class="hero-rule hero-rule-bot"></div>
  </section>

  <!-- ── How it works ──────────────────────────────────── -->
  <section class="how">
    <div class="how-inner">
      <p class="section-label">The loop</p>
      <h2 class="section-title">Find it. Track it. Catch it.</h2>

      <ol class="how-steps">
        <li class="how-step">
          <span class="how-num">01</span>
          <div class="how-body">
            <h3>Find the scenarios that cost your team the most time.</h3>
            <p>
              Wezel observes real builds across your whole team — no manual instrumentation needed —
              and surfaces which scenarios eat the most time, for the most people, most often.
            </p>
          </div>
        </li>
        <li class="how-step">
          <span class="how-num">02</span>
          <div class="how-body">
            <h3>Track them on every commit.</h3>
            <p>
              Once you know what matters, Wezel benchmarks those scenarios on every commit in CI and
              keeps the full history, so you can see exactly when things changed and how the trend is moving.
            </p>
          </div>
        </li>
        <li class="how-step">
          <span class="how-num">03</span>
          <div class="how-body">
            <h3>Catch each regression at the commit that caused it.</h3>
            <p>
              The moment a commit adds meaningful build time, Wezel tells you — which commit, how much,
              what it affected — while it's still a single change to revisit, not after it's already baked into your baseline.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ── Example experiment ───────────────────────────── -->
  <section class="example">
    <div class="example-inner">
      <p class="section-label">An example</p>
      <h2 class="section-title">What you write. What Wezel watches.</h2>
      <p class="example-sub">
        A workspace-build experiment for Wezel itself: <code>cargo</code> compiles the workspace
        and emits per-crate timing outcomes. Experiments are sequences of <em>steps</em> that run
        <em>tools</em>; each step produces <em>outcomes</em>; and a single outcome can feed
        <em>multiple summaries</em> — total time, the slowest crate, whatever metric you want
        tracked separately across commits.
      </p>

      <div class="example-grid">
        <figure class="example-code">
          <figcaption>
            <span class="example-path">.wezel/experiments/workspace-build/experiment.toml</span>
            <span class="example-lang">toml</span>
          </figcaption>
          <Code code={experimentToml} lang="toml" theme="vitesse-dark" />
        </figure>

        <figure class="example-alert">
          <figcaption>
            <span class="example-alert-tag">⚠ regression detected</span>
            <span class="example-alert-ts">2026-05-15</span>
          </figcaption>
          <dl class="alert-fields">
            <div><dt>experiment</dt><dd>workspace-build</dd></div>
            <div><dt>summary</dt><dd>workspace-build-time</dd></div>
            <div><dt>commit</dt><dd class="alert-hash">a3f8c1d</dd></div>
            <div><dt>baseline</dt><dd>47.3s · trailing 30 commits</dd></div>
            <div><dt>current</dt><dd class="alert-warn">59.7s · +12.4s · +26%</dd></div>
            <div><dt>cause</dt><dd>core::parser — new generic impl, 38 downstream rebuilds</dd></div>
          </dl>
          <a class="alert-link" href="#">view in dashboard →</a>
        </figure>
      </div>

      <p class="example-caption">
        You commit the <code>experiment.toml</code>. Wezel runs the steps on each commit in CI,
        stores every summary the experiment defines, and flags the bisected commit the moment any
        of them drifts past your tolerance.
      </p>
    </div>
  </section>

  <!-- ── Why Wezel ─────────────────────────────────────── -->
  <section class="why">
    <div class="why-inner">
      <p class="section-label">Why Wezel</p>

      <div class="why-grid">
        <article class="why-item" data-tone="red">
          <span class="why-tag">
            <span class="why-tag-mark"></span>
            team cost
          </span>
          <h3>Build time, <em>totaled</em> across your team.</h3>
          <p>
            Build time spent by one engineer multiplied by everyone else is the real number.
            Wezel quantifies aggregate wait time so you can prioritize what's actually worth fixing.
          </p>
        </article>

        <article class="why-item" data-tone="accent">
          <span class="why-tag">
            <span class="why-tag-mark"></span>
            per-commit signal
          </span>
          <h3>Regressions, <em>caught</em> at the commit.</h3>
          <p>
            Every commit gets benchmarked against the previous baseline. A change that adds 15 seconds
            to your most-run scenario gets surfaced immediately — not after it's baked in.
          </p>
        </article>

        <article class="why-item" data-tone="green">
          <span class="why-tag">
            <span class="why-tag-mark"></span>
            open &amp; owned
          </span>
          <h3>Open source, <em>your</em> data.</h3>
          <p>
            Self-host the entire stack for free, forever — MIT-licensed, no telemetry, no vendor lock-in.
            Built in the open with the community, not behind a feature gate.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ── Bottom CTA ────────────────────────────────────── -->
  <section class="bottom-cta">
    <div class="bottom-cta-glow"></div>
    <div class="bottom-cta-inner">
      <div class="bottom-cta-text">
        <p class="section-label">Start the loop</p>
        <h2>
          Make build speed<br />
          a <em>priority.</em>
        </h2>
      </div>
      <div class="bottom-cta-aside">
        <p>
          Wezel surfaces your slowest scenarios, benchmarks them on every commit,
          and tells you when a change adds time.
        </p>
        <div class="bottom-cta-buttons">
          <a href="https://github.com/wezel-build/wezel" class="btn btn-lg btn-primary" target="_blank" rel="noopener">
            Get started on GitHub
          </a>
          <a href="/docs" class="btn btn-lg btn-ghost-line">
            Read the docs <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* ── Hero ───────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 4.5rem 0 2rem;
  }

  .hero-rule {
    position: absolute;
    left: 2rem;
    right: 2rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-light) 20%, var(--border-light) 80%, transparent);
    opacity: 0.5;
  }
  .hero-rule-top { top: 0; }
  .hero-rule-bot { bottom: 0; }

  .hero-glow {
    position: absolute;
    top: -200px;
    right: -120px;
    width: 720px;
    height: 520px;
    background: radial-gradient(ellipse at center, var(--accent-glow-strong) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 2rem 3rem;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 3.5rem;
    align-items: center;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.4rem, 4.4vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--text);
    margin: 0 0 1.5rem;
  }

  .hero-title em,
  .accent-mark {
    font-style: normal;
    color: var(--accent);
    background-image: linear-gradient(
      0deg,
      var(--accent-glow-strong) 0%,
      var(--accent-glow-strong) 28%,
      transparent 28%
    );
    padding: 0 0.12em;
    margin: 0 -0.04em;
  }

  .hero-sub {
    font-size: 1.05rem;
    color: var(--text-mid);
    line-height: 1.65;
    max-width: 38ch;
    margin: 0 0 2rem;
  }

  .hero-ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 2.75rem;
  }

  .btn-ghost-line {
    background: transparent;
    color: var(--text);
    border: none;
    padding: 0.85rem 0.5rem;
    position: relative;
  }
  .btn-ghost-line::after {
    content: "";
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0.6rem;
    height: 1px;
    background: var(--text-dim);
    transform-origin: left;
    transform: scaleX(0.4);
    transition: transform 0.25s ease, background 0.25s ease;
  }
  .btn-ghost-line:hover::after {
    transform: scaleX(1);
    background: var(--accent);
  }

  /* Hero meta strip */
  .hero-meta {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 2rem;
    padding: 1rem 0 0;
    border-top: 1px solid var(--border);
    max-width: 36rem;
    margin: 0;
  }
  .hero-meta dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.25rem;
  }
  .hero-meta dd {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text);
    letter-spacing: -0.01em;
    margin: 0;
  }
  .hero-meta .meta-warn { color: var(--red); }

  /* ── Chart ────────────────────────────────────────── */
  .hero-chart {
    position: relative;
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg-deep) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1rem 1.1rem 1.1rem;
    margin: 0;
    box-shadow:
      0 16px 48px rgba(0, 0, 0, 0.4),
      0 0 80px var(--accent-glow);
  }

  .chart-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px dashed var(--border);
    margin-bottom: 0.85rem;
  }
  .chart-head-key {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .chart-head-key-right {
    margin-left: auto;
    color: var(--green);
  }
  .chart-head-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    margin-left: auto;
    box-shadow: 0 0 8px var(--green);
    animation: pulse 1.8s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }

  .chart-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .chart-svg .grid-line {
    stroke: var(--border);
    stroke-width: 1;
    opacity: 0.7;
  }
  .chart-svg .baseline-line {
    stroke: var(--accent);
    stroke-width: 1;
    opacity: 0.55;
  }
  .chart-svg .axis-line {
    stroke: var(--border-light);
    stroke-width: 1;
  }
  .chart-svg .axis-label {
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: var(--text-dim);
  }
  .chart-svg .axis-label-right {
    text-anchor: end;
  }
  .chart-svg .bar {
    transform-origin: center bottom;
    transform-box: fill-box;
    animation: bar-grow 700ms cubic-bezier(.16,.7,.27,1) var(--d, 0ms) backwards;
  }
  .chart-svg .marker-line {
    stroke: var(--red);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    opacity: 0;
    animation: fade-in 500ms 1450ms forwards;
  }
  .chart-svg .marker-label {
    opacity: 0;
    animation: rise 600ms 1550ms backwards forwards;
  }
  .chart-svg .marker-hash {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    fill: var(--red);
    letter-spacing: 0.02em;
  }
  .chart-svg .marker-delta {
    font-family: var(--font-mono);
    font-size: 9.5px;
    fill: var(--text);
    letter-spacing: 0.01em;
  }
  .chart-svg .marker-cause {
    font-family: var(--font-mono);
    font-size: 8.5px;
    fill: var(--text-dim);
    letter-spacing: 0.02em;
  }

  @keyframes bar-grow {
    from { transform: scaleY(0); opacity: 0; }
    to { transform: scaleY(1); opacity: 1; }
  }
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes rise {
    from { opacity: 0; transform: translate(var(--rx, 0), 6px); }
    to { opacity: 1; transform: translate(0, 0); }
  }

  /* Hero copy stagger animation */
  .hero-anim {
    opacity: 0;
    animation: hero-rise 700ms cubic-bezier(.2,.7,.27,1) var(--d, 0ms) forwards;
  }
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Section shared ────────────────────────────────── */
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.05em;
    line-height: 1.1;
    margin: 0 0 2.5rem;
    max-width: 24ch;
  }

  .section-title em {
    font-style: normal;
    color: var(--accent);
    background-image: linear-gradient(
      0deg,
      var(--accent-glow-strong) 0%,
      var(--accent-glow-strong) 28%,
      transparent 28%
    );
    padding: 0 0.1em;
    margin: 0 -0.04em;
  }

  /* ── How it works ──────────────────────────────────── */
  .how {
    padding: 5rem 0;
    border-top: 1px solid var(--border);
  }

  .how-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .how-steps {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
    max-width: 56rem;
  }

  .how-step {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 2.5rem;
    padding: 2rem 0;
    border-top: 1px solid var(--border);
    align-items: baseline;
  }
  .how-step:last-child {
    border-bottom: 1px solid var(--border);
  }

  .how-num {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.4rem;
    color: var(--accent);
    line-height: 1.2;
    letter-spacing: -0.04em;
  }
  .how-num::after {
    content: "";
    display: block;
    width: 28px;
    height: 1px;
    background: var(--accent);
    opacity: 0.6;
    margin-top: 0.7rem;
  }

  .how-body h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--text);
    letter-spacing: -0.04em;
    margin: 0 0 0.6rem;
    line-height: 1.18;
  }

  .how-body p {
    font-size: 0.98rem;
    color: var(--text-mid);
    line-height: 1.65;
    max-width: 56ch;
    margin: 0;
  }

  /* ── Example experiment ────────────────────────────── */
  .example {
    position: relative;
    padding: 5.5rem 0 5rem;
    border-top: 1px solid var(--border);
  }

  .example-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .example-sub {
    font-size: 1.02rem;
    color: var(--text-mid);
    line-height: 1.7;
    max-width: 64ch;
    margin: -1rem 0 3rem;
  }

  .example-sub code,
  .example-caption code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.05em 0.4em;
    border-radius: 4px;
  }

  .example-sub em {
    font-style: normal;
    color: var(--accent);
    font-weight: 500;
  }

  .example-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1.25rem;
    align-items: start;
  }

  .example-code,
  .example-alert {
    background: var(--bg-deep);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    margin: 0;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
  }

  .example-code figcaption,
  .example-alert figcaption {
    display: flex;
    align-items: center;
    gap: 0.6rem;
